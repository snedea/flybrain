ANTHROPIC_API_KEY=sk-ant-your-key-here

# Fly @ Work (Workday integration) -- see docs/WORKDAY.md
# mock (default): no network, canned request IDs. live: real MCP calls.
WORKDAY_MODE=mock
WORKDAY_MCP_URL=https://us.agent.workday.com/mcp
# Tenant token (expires every 60 min): wdcli tenant token <tenant>
WORKDAY_TOKEN=
# The fly's Employee_ID in your tenant, and a coworker for kudos
WORKDAY_WORKER_ID=21001
WORKDAY_COWORKER_ID=21002
